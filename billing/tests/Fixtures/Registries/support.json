    "automation": {
        "tasks/support.auto_close": {
            "stage": 90,
            "handler": "Closure(App\\Support\\CalendarDate $today)",
            "label": "Close idle tickets",
            "description": "Closes tickets that have waited on the customer longer than the auto-close period."
        },
        "tasks/support.purge_inbound_raw": {
            "stage": 90,
            "handler": "Closure(App\\Support\\CalendarDate $today)",
            "label": "Purge raw inbound emails",
            "description": "Deletes stored raw inbound email payloads older than the retention period."
        },
        "tasks/support.prune_attachments": {
            "stage": 90,
            "handler": "Closure(App\\Support\\CalendarDate $today)",
            "label": "Delete old ticket attachments",
            "description": "Deletes attachment files from tickets closed longer than the configured months (details stay)."
        },
        "takesCalendarDate/support.auto_close": true,
        "takesCalendarDate/support.purge_inbound_raw": true,
        "takesCalendarDate/support.prune_attachments": true,
        "takesCarbonDate/support.auto_close": false,
        "takesCarbonDate/support.purge_inbound_raw": false,
        "takesCarbonDate/support.prune_attachments": false
    },
