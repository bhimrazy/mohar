# Edge proxy for deploy/compose.prod.yaml: TLS, HTTP->HTTPS redirect and forwarding to the app container.
# Certificates are automatic for a public APP_DOMAIN: Let's Encrypt, plus ZeroSSL as a fallback only when an email is
# set (CADDY_GLOBAL_OPTIONS="email ..."); `localhost` and
# *.internal names get a certificate from Caddy's internal CA, which the deploy smoke test uses.
# Security headers (CSP, HSTS, ...) come from the app, so none are added here.
{
	# Do not try to add the internal CA to this container's trust store.
	skip_install_trust
	# The admin API listens inside this container only; it is what a graceful `caddy reload` talks to.
	admin localhost:2019
	# Optional global options from deploy/.env, e.g. CADDY_GLOBAL_OPTIONS="email ops@example.com" for ACME notices.
	{$CADDY_GLOBAL_OPTIONS:}
	servers {
		# HTTP/3 needs 443/udp published (compose.prod.yaml does).
		protocols h1 h2 h3
	}
}

{$APP_DOMAIN} {
	# Empty by default; `tls internal` forces the internal CA for a non-public test name.
	{$CADDY_TLS:}

	reverse_proxy app:8080 {
		# Caddy sets X-Forwarded-For, -Proto and -Host itself, ignoring a client's values; other X-Forwarded-* headers
		# pass through, so the app trusts only those three, and only from this proxy's network (TRUSTED_PROXIES).
		health_uri /up
		health_interval 10s
		health_headers {
			Host {$APP_DOMAIN}
		}
		# A restarting app container is retried for a few seconds instead of answering 502 at once.
		lb_try_duration 5s
	}

	# Access log without secrets: one-time tokens travel in URLs (password reset, staff and account invitations,
	# email verification paths; signed links' and guest tickets' query strings). Their path segment and every query
	# string are replaced by REDACTED, and the Referer, which repeats those URLs, is dropped. Caddy already logs
	# Cookie and Authorization as REDACTED.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "^(/(?:reset-password|staff-invitation|account-invitation|email/verify)/)[^?]*|(\?).*$" "${1}${2}REDACTED"
			request>headers>Referer delete
		}
	}
}
