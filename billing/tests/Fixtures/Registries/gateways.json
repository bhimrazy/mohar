        "sandbox_card": {
            "position": 2,
            "class": "SandboxCardDriver",
            "name": "Card (sandbox)",
            "capabilities": [
                "capture",
                "tokenize",
                "remote_input",
                "refund",
                "partial_refund",
                "webhook",
                "pending_settlement",
                "redirect",
                "lookup",
                "stored_methods"
