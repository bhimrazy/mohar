                    "key": "signing_key",
                    "label": "Signing certificate",
                    "type": "certificate",
                    "required": true,
                    "help": "The .pfx file NCHL issues (CREDITOR.pfx) and its passphrase. Only the private key is kept, encrypted.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                }
            ]
