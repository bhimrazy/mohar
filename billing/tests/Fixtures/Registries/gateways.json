            "interfaces": ["hosted", "cancel_hosted", "resume_hosted"],
            "currencies": ["USD", "INR", "NPR"],
            "fields": [
                {
                    "key": "checkout_mode",
                    "label": "Client checkout",
                    "type": "select",
                    "required": false,
                    "help": null,
                    "options": {
                        "inline": "Card form on the invoice (tokenised)",
                        "hosted": "Hosted payment page (redirect + lookup)"
                    },
                    "default": "inline",
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "webhook_secret",
                    "label": "Webhook signing secret",
                    "type": "secret",
                    "required": false,
                    "help": "Used to verify X-Sandbox-Signature on callbacks.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "fee_percent",
                    "label": "Simulated fee (%)",
                    "type": "string",
                    "required": false,
                    "help": "Fee recorded on successful charges, e.g. 2.9",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                }
            ]
        },
        "cybersource": {
            "position": 3,
            "class": "CybersourceDriver",
            "name": "Cards (Cybersource, NIC Asia)",
            "capabilities": [
                "redirect",
                "lookup",
                "webhook",
                "refund",
                "partial_refund"
            ],
            "interfaces": ["hosted", "test_connection", "refund_lookup"],
            "currencies": ["NPR"],
            "fields": [
                {
                    "key": "sandbox",
                    "label": "Test mode",
                    "type": "boolean",
                    "required": false,
                    "help": "Uses Cybersource's test hosts (testsecureacceptance and apitest.cybersource.com); no real money moves. Not available in production.",
                    "options": [],
                    "default": true,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "merchant_id",
                    "label": "Merchant ID",
                    "type": "string",
                    "required": true,
                    "help": "Your Cybersource organisation ID, given by NIC Asia Bank with the service agreement.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "profile_id",
                    "label": "Secure Acceptance profile ID",
                    "type": "string",
                    "required": true,
                    "help": "From the Business Center, Payment Configuration → Secure Acceptance. In the profile, set the customer response page to the return URL below and the merchant POST URL to the webhook URL below.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "access_key",
                    "label": "Profile access key",
                    "type": "string",
                    "required": true,
                    "help": "Created with the profile's security key. It is sent in the payment form, so it is not a secret.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "secret_key",
                    "label": "Profile secret key",
                    "type": "secret",
                    "required": true,
                    "help": "Created with the access key; signs the payment form and checks Cybersource's replies.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "rest_key_id",
                    "label": "REST key ID",
                    "type": "string",
                    "required": true,
                    "help": "Business Center, Key Management: a REST shared secret key. Required: card payments are confirmed only through the REST API, so the gateway can't be activated without it.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                },
                {
                    "key": "rest_secret",
                    "label": "REST shared secret",
                    "type": "secret",
                    "required": true,
                    "help": "The base64 shared secret shown once when the REST key is created. Required: card payments are confirmed only through the REST API, so the gateway can't be activated without it.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
                }
            ]
        },
