        "sections/email_delivery/notifications.from.default": {
            "class": "App\\Support\\Settings\\SettingDefinition",
            "key": "notifications.from.default",
            "label": "Send email from",
            "type": "email",
            "help": "Sender for client and staff email; empty = MAIL_FROM_ADDRESS. The sender name is always the company name. Use an address on a domain your mail provider is authorised to send for (SPF/DKIM), so DMARC passes.",
            "options": [],
            "rules": ["nullable", "email", "max:255"],
            "secret": false
        },
        "sections/email_delivery/notifications.from.billing": {
            "class": "App\\Support\\Settings\\SettingDefinition",
            "key": "notifications.from.billing",
            "label": "Send billing email from",
            "type": "email",
            "help": "Sender for invoices, receipts and reminders, e.g. billing@ your domain. Must be on the same authorised sending domain (DMARC alignment).",
            "options": [],
            "rules": ["nullable", "email", "max:255"],
            "secret": false
        },
        "sections/email_delivery/notifications.support_email": {
            "class": "App\\Support\\Settings\\SettingDefinition",
            "key": "notifications.support_email",
            "label": "Support email address",
            "type": "email",
            "help": "Reply-To for general email and the address named in every footer. Defaults to the billing email address. Never a no-reply mailbox.",
            "options": [],
            "rules": ["nullable", "email", "max:255"],
            "secret": false
        },
        "sections/email_delivery/notifications.auth_link_host": {
            "class": "App\\Support\\Settings\\SettingDefinition",
            "key": "notifications.auth_link_host",
            "label": "Other host for account links",
            "type": "string",
            "help": "Only if reset and verification pages live on another domain than APP_URL (comma-separated host names). One-time links to any other host are never sent.",
            "options": [],
            "rules": [
                "nullable",
                "max:255",
                "regex:/^\\s*$|^\\s*[a-z0-9.-]+(\\s*,\\s*[a-z0-9.-]+)*\\s*$/i"
            ],
            "secret": false
        },
        "sections/email_delivery/notifications.mail_bcc": {
            "class": "App\\Support\\Settings\\SettingDefinition",
            "key": "notifications.mail_bcc",
            "label": "BCC every client email to",
            "type": "string",
            "help": "Comma-separated addresses. Never applied to mail carrying a reset, verification or invitation link.",
            "options": [],
            "rules": [
                "max:500",
                "regex:/^\\s*$|^\\s*[^@\\s,]+@[^@\\s,]+\\.[^@\\s,]+(\\s*,\\s*[^@\\s,]+@[^@\\s,]+\\.[^@\\s,]+)*\\s*$/"
            ],
            "secret": false
        }
