{
    "name": "docs-site",
    "private": true,
    "type": "module",
    "description": "Public documentation for hosts who install and run the billing app. Built with Astro Starlight.",
    "scripts": {
        "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 8140",
        "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
        "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 8141",
        "deploy:branch": "bash scripts/deploy-branch.sh"
    },
    "dependencies": {
        "@astrojs/starlight": "0.42.6",
        "@fontsource-variable/inter": "5.3.0",
        "astro": "7.3.8",
        "starlight-image-zoom": "0.16.1"
    }
}
