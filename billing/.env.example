APP_NAME=Mohar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Reverse proxies allowed to set the client IP and scheme (X-Forwarded-*), comma-separated addresses or CIDR
# ranges. Leave unset when nothing sits in front of the app; never "*" on a reachable network.
# TRUSTED_PROXIES=172.18.0.0/16

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# PostgreSQL (production parity): `docker compose up -d postgres`, then replace the line above with
# this block and run `php artisan migrate:fresh --seed`. compose.yaml creates the server from the
# same DB_* values (defaults: billing/billing/billing) plus a `billing_test` database for the tests.
# See docs/devops/local-setup.md.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=billing
# DB_USERNAME=billing
# DB_PASSWORD=billing
# How long migration DDL waits for a table lock on PostgreSQL before it retries (docs/architecture.md).
# DB_MIGRATION_LOCK_TIMEOUT=3s
# DB_MIGRATION_CONCURRENT_LOCK_TIMEOUT=60s

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Seconds a password confirmation unlocks sensitive changes (whole number, 60 to 3600; empty or unset = 900).
# AUTH_STEP_UP_SECONDS=900

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia server-side rendering stays off until an SSR bundle exists (config/inertia.php).
INERTIA_SSR_ENABLED=false

OBJECTS_DRIVER=s3
OBJECTS_ENDPOINT=http://127.0.0.1:9000
OBJECTS_ACCESS_KEY=billing
OBJECTS_SECRET_KEY=billing-secret
OBJECTS_BUCKET=billing
OBJECTS_REGION=us-east-1

# Billing sandbox gateway (null = enabled except in production)
BILLING_SANDBOX_ENABLED=

# Card payments (Cybersource, NIC Asia): currencies the bank agreement allows
CYBERSOURCE_CURRENCIES=NPR
