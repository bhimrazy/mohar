# Large VPS: 8 vCPU, 16 GB RAM. Memory limits add up to 14,656 MB. See small.env for how the caps are applied.
PROFILE_CPUS=8
PROFILE_MEMORY=16G

CADDY_CPUS=2
CADDY_MEMORY=256M

APP_CPUS=8
APP_MEMORY=5120M
PHP_THREADS=16

WORKER_CRITICAL_REPLICAS=2
WORKER_CRITICAL_CPUS=1
WORKER_CRITICAL_MEMORY=320M
WORKER_NOTIFICATIONS_REPLICAS=3
WORKER_NOTIFICATIONS_CPUS=1
WORKER_NOTIFICATIONS_MEMORY=320M
WORKER_DEFAULT_REPLICAS=2
WORKER_DEFAULT_CPUS=1
WORKER_DEFAULT_MEMORY=320M

SCHEDULER_CPUS=1
SCHEDULER_MEMORY=384M

POSTGRES_CPUS=8
POSTGRES_MEMORY=6144M
PG_SHARED_BUFFERS=1536MB
PG_EFFECTIVE_CACHE_SIZE=4608MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100

RUSTFS_CPUS=2
RUSTFS_MEMORY=512M

LOAD_LEVELS="20 40 80 160"
LEVEL_DURATION=2m
