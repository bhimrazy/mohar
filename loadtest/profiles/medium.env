# Medium VPS: 4 vCPU, 8 GB RAM. Memory limits add up to 7,296 MB. See small.env for how the caps are applied.
PROFILE_CPUS=4
PROFILE_MEMORY=8G

CADDY_CPUS=1
CADDY_MEMORY=192M

APP_CPUS=4
APP_MEMORY=2560M
PHP_THREADS=8

WORKER_CRITICAL_REPLICAS=1
WORKER_CRITICAL_CPUS=1
WORKER_CRITICAL_MEMORY=320M
WORKER_NOTIFICATIONS_REPLICAS=2
WORKER_NOTIFICATIONS_CPUS=1
WORKER_NOTIFICATIONS_MEMORY=320M
WORKER_DEFAULT_REPLICAS=1
WORKER_DEFAULT_CPUS=1
WORKER_DEFAULT_MEMORY=320M

SCHEDULER_CPUS=1
SCHEDULER_MEMORY=320M

POSTGRES_CPUS=4
POSTGRES_MEMORY=2560M
PG_SHARED_BUFFERS=640MB
PG_EFFECTIVE_CACHE_SIZE=1920MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=60

RUSTFS_CPUS=1
RUSTFS_MEMORY=384M

LOAD_LEVELS="10 20 40 80"
LEVEL_DURATION=2m
