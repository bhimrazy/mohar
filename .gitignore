.claude/worktrees/
# Old location, kept while worktrees from before the move exist.
.worktrees/
# Marks a worktree an agent is using; scripts/sweep-stale.sh skips it.
.claude-in-use
rea/

# Production secrets for deploy/compose.prod.yaml (copy of deploy/.env.production.example)
/deploy/.env
/deploy/.env.*
!/deploy/.env.production.example

# Load-test results (loadtest/bin/run); the workflow uploads them as artifacts
/loadtest/results/

# Blue-green state for deploy/bin/deploy (live colour, images, the upstream Caddy imports)
/deploy/state/
