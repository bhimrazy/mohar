# Small VPS: 2 vCPU, 4 GB RAM. loadtest/bin/run caps the whole stack at these totals (a cgroup parent slice), and
# each service at its own limit below. Memory limits add up to 3,968 MB, leaving the rest for the kernel and page
# cache; CPU limits are ceilings within the 2 vCPU total, not reservations (services rarely peak together).
PROFILE_CPUS=2
PROFILE_MEMORY=4G

CADDY_CPUS=0.5
CADDY_MEMORY=128M

# FrankenPHP classic mode: one PHP thread per concurrent request (2 per vCPU, FrankenPHP's own default).
APP_CPUS=2
APP_MEMORY=1280M
PHP_THREADS=4

WORKER_CRITICAL_REPLICAS=1
WORKER_CRITICAL_CPUS=1
WORKER_CRITICAL_MEMORY=256M
WORKER_NOTIFICATIONS_REPLICAS=1
WORKER_NOTIFICATIONS_CPUS=1
WORKER_NOTIFICATIONS_MEMORY=256M
WORKER_DEFAULT_REPLICAS=1
WORKER_DEFAULT_CPUS=1
WORKER_DEFAULT_MEMORY=256M

SCHEDULER_CPUS=1
# 512 MB as in deploy/compose.prod.yaml: at 256 MB the billing day at the large volume stopped early (PR #543).
SCHEDULER_MEMORY=512M

# PostgreSQL: shared_buffers at 25% of its container (the docs' starting point for a dedicated server),
# effective_cache_size at 75% (a planner estimate of cache, not an allocation), work_mem per sort or hash.
POSTGRES_CPUS=2
POSTGRES_MEMORY=1024M
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=40

RUSTFS_CPUS=0.5
RUSTFS_MEMORY=256M

# Concurrent virtual users per step of the ramp, and how long each step runs.
LOAD_LEVELS="5 10 20 40"
LEVEL_DURATION=2m
