{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "3.1.2",
        "inertiajs/inertia-laravel": "3.5.1",
        "laravel/chisel": "0.1.1",
        "laravel/fortify": "1.41.0",
        "laravel/framework": "13.35.0",
        "laravel/tinker": "3.0.2",
        "laravel/wayfinder": "0.1.21",
        "league/flysystem-aws-s3-v3": "3.35.3"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "larastan/larastan": "3.13.0",
        "laravel/boost": "2.10.3",
        "laravel/pail": "1.2.7",
        "laravel/pao": "1.1.5",
        "laravel/pint": "1.32.1",
        "laravel/sail": "1.69.0",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.5",
        "pestphp/pest": "5.3.1",
        "pestphp/pest-plugin-drift": "5.0.0",
        "pestphp/pest-plugin-laravel": "5.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=off",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan wayfinder:generate --with-form --ansi",
            "npm run check",
            "npm run types:check",
            "@types:check",
            "@php vendor/bin/pest --parallel",
            "@test:pgsql",
            "npm run build"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "test:pgsql": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=off",
            "@php artisan config:clear --ansi",
            "DB_CONNECTION=pgsql DB_HOST=${DB_HOST:-127.0.0.1} DB_PORT=${DB_PORT:-5432} DB_DATABASE=${DB_DATABASE:-billing_test} DB_USERNAME=${DB_USERNAME:-billing} DB_PASSWORD=${DB_PASSWORD:-billing} \"$PHP_BINARY\" artisan migrate:fresh --seed --force --no-interaction",
            "DB_CONNECTION=pgsql DB_HOST=${DB_HOST:-127.0.0.1} DB_PORT=${DB_PORT:-5432} DB_DATABASE=${DB_DATABASE:-billing_test} DB_USERNAME=${DB_USERNAME:-billing} DB_PASSWORD=${DB_PASSWORD:-billing} \"$PHP_BINARY\" vendor/bin/pest --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "report"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "ci": "Run every CI gate locally, including migrate:fresh --seed + tests on PostgreSQL (needs `docker compose up -d`).",
        "test:pgsql": "migrate:fresh --seed + the test suite on PostgreSQL (DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD override the compose defaults; database is created if missing)."
    }
}
