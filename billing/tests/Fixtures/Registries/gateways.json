                {
                    "key": "secret_key",
                    "label": "Secret key",
                    "type": "secret",
                    "required": true,
                    "help": "Provided by eSewa for signing. UAT: the public test key from eSewa's developer docs.",
                    "options": [],
                    "default": null,
                    "optionsSource": null,
                    "minLength": null
