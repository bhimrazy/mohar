#!/usr/bin/env bash
# One-shot smoke install of the production stack (deploy/compose.prod.yaml) on fresh volumes, deployed with
# deploy/bin/deploy and checked through Caddy with a certificate from Caddy's internal CA. Used by
# .github/workflows/deploy-smoke.yml; runs anywhere Docker Compose v2 can network containers. It never reads or
# writes deploy/.env or deploy/state: it generates its own deploy/.env.smoke (gitignored), state directory and
# compose project, and removes them on exit.
#
#   deploy/bin/smoke                build the image, install, deploy blue, check, deploy green, roll back, tear down
#   SMOKE_KEEP=1 deploy/bin/smoke   leave the stack running for inspection (remove it with the printed command)
#
# Checks: migrations, bucket and first administrator on empty PostgreSQL and RustFS; the first deploy (blue); /up
# through Caddy over HTTPS with HSTS (so the proxy is trusted); HTTP redirects to HTTPS; sign-in; URL tokens never
# reach Caddy's access log; a queued RunAutomationJob processed by the live colour's automation worker (its own queue
# connection); UID 10001 on a read-only root; PHP stream TLS verifies public certificates; compiled views stay per
# container. Then a blue-green deploy to green and a rollback to blue under a steady request loop: no failed request,
# the live upstream, one scheduler and one automation worker, and the old colour's workers drained. Last, the full
# demo seeder (`db:seed --force`) on the stack's PostgreSQL with real commits, run once with APP_ENV=local because
# the stack itself runs as production, which skips demo data (#126).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

project="${SMOKE_PROJECT:-mohar-smoke}"
http_port="${SMOKE_HTTP_PORT:-18080}"
https_port="${SMOKE_HTTPS_PORT:-18443}"
image="${SMOKE_IMAGE:-mohar-app:smoke}"
env_file="deploy/.env.smoke"
work="$(mktemp -d)"
base="https://localhost:${https_port}"
admin_email="smoke-admin@example.com"
export DEPLOY_ENV_FILE="$env_file" DEPLOY_PROJECT="$project" DEPLOY_STATE_DIR="$work/state"
compose=(docker compose -p "$project" -f deploy/compose.prod.yaml --env-file "$env_file" --profile blue --profile green)
failed=1

# This script ends with `down -v` and seeds demo data: it must never be pointed at a real stack.
case "$project" in
    mohar-smoke|mohar-smoke-*) ;;
    *) echo "FAIL SMOKE_PROJECT='$project' is not a smoke project (mohar-smoke or mohar-smoke-*); refusing to run" >&2; exit 1 ;;
esac

step() { printf '\n== %s\n' "$*"; }
pass() { printf 'PASS %s\n' "$*"; [ -n "${GITHUB_STEP_SUMMARY:-}" ] && printf -- '- PASS %s\n' "$*" >> "$GITHUB_STEP_SUMMARY"; return 0; }
fail() { printf 'FAIL %s\n' "$*" >&2; [ -n "${GITHUB_STEP_SUMMARY:-}" ] && printf -- '- FAIL %s\n' "$*" >> "$GITHUB_STEP_SUMMARY"; exit 1; }
random() { head -c 32 /dev/urandom | base64 | tr -d '/+=' | cut -c1-"${1:-32}"; }
running() { "${compose[@]}" ps --status running --services | sort | tr '\n' ' '; }

cleanup() {
    [ -n "${loop_pid:-}" ] && kill "$loop_pid" 2>/dev/null || true
    # Put back the Caddyfile the blue-green step changed, if it did not get to.
    [ -f "$work/Caddyfile.orig" ] && mv "$work/Caddyfile.orig" deploy/caddy/Caddyfile
    if [ "$failed" = 1 ]; then
        step "diagnostics"
        "${compose[@]}" ps -a || true
        "${compose[@]}" logs --no-color --tail 60 || true
    fi
    if [ "${SMOKE_KEEP:-0}" = 1 ]; then
        echo "Stack kept. Remove it with: ${compose[*]} down -v --remove-orphans && rm -rf $env_file $work"
        return
    fi
    "${compose[@]}" down -v --remove-orphans --timeout 20 >/dev/null 2>&1 || true
    docker rmi "${image%:*}:smoke-seed" >/dev/null 2>&1 || true
    rm -f "$env_file"
    rm -rf "$work"
}
trap cleanup EXIT

step "environment (generated secrets, internal TLS, log mailer)"
cat > "$env_file" <<ENV
APP_DOMAIN=localhost
APP_URL=${base}
APP_NAME="Smoke Test Host"
APP_KEY=base64:$(head -c 32 /dev/urandom | base64)
APP_ENV=production
APP_DEBUG=false
APP_ENV_FILE=.env.smoke
CADDY_TLS=tls internal
HTTP_PORT=${http_port}
HTTPS_PORT=${https_port}
APP_IMAGE=${image}
DB_DATABASE=billing
DB_USERNAME=billing
DB_PASSWORD=$(random)
OBJECTS_BUCKET=billing
OBJECTS_ACCESS_KEY=$(random 20)
OBJECTS_SECRET_KEY=$(random 40)
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
MAIL_MAILER=log
ENV
chmod 600 "$env_file"
docker compose version

if [ -z "${SMOKE_IMAGE:-}" ]; then
    step "build the image (deploy/Dockerfile, target prod)"
    start=$(date +%s)
    APP_IMAGE="$image" "${compose[@]}" build migrate
    pass "image built in $(( $(date +%s) - start ))s"
fi
docker image inspect "$image" --format 'image size (unpacked): {{.Size}} bytes'

step "first install on empty PostgreSQL and RustFS"
"${compose[@]}" up -d --wait --wait-timeout 120 postgres rustfs
APP_IMAGE="$image" "${compose[@]}" run --rm -T migrate sh -c "php artisan migrate --force --no-interaction \
    && php artisan objects:ensure-bucket --no-interaction \
    && php artisan app:install --no-interaction --admin-name='Smoke Admin' --admin-email=${admin_email}" > "$work/install.log" 2>&1 \
    || { awk 'hide && NF { print "   <one-time password hidden>"; hide = 0; next } /one-time password/ { hide = 1 } { print }' "$work/install.log" | tail -40 >&2; fail "first install"; }
# The one-time password is the first non-empty line after the notice; it is masked and never printed.
password="$(awk 'found && NF { print $1; exit } /one-time password/ { found = 1 }' "$work/install.log")"
[ -n "$password" ] || fail "no one-time password in the install output"
[ -n "${GITHUB_ACTIONS:-}" ] && echo "::add-mask::${password}"
pass "migrations, bucket and first administrator"

step "first deploy (blue)"
start=$(date +%s)
deploy/bin/deploy --image "$image" || fail "first deploy"
pass "deployed blue in $(( $(date +%s) - start ))s (migration check, migrate, health, switch)"
for service in app-blue caddy postgres rustfs scheduler-blue worker-automation-blue worker-critical-blue worker-default-blue worker-notifications-blue; do
    grep -qw "$service" <<< "$(running)" || fail "service $service is not running (running: $(running))"
done
pass "running: $(running)"

step "HTTPS through Caddy (internal CA)"
for _ in $(seq 30); do
    "${compose[@]}" cp caddy:/data/caddy/pki/authorities/local/root.crt "$work/root.crt" >/dev/null 2>&1 && break
    sleep 1
done
[ -s "$work/root.crt" ] || fail "Caddy's internal root certificate"
# Retries: the leaf certificate can lag a moment behind the root certificate.
curl_tls=(curl -sS --cacert "$work/root.crt" --max-time 15 --retry 5 --retry-all-errors --retry-delay 1)
headers="$("${curl_tls[@]}" -D - -o /dev/null "${base}/up")"
grep -q '^HTTP/[0-9.]* 200' <<< "$headers" || fail "GET /up through Caddy: $(head -1 <<< "$headers")"
grep -qi '^strict-transport-security:' <<< "$headers" || fail "no HSTS on /up: the app does not trust the proxy"
pass "GET ${base}/up = 200 with a trusted certificate and HSTS"
redirect="$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' "http://localhost:${http_port}/login")"
redirect_pattern='^30[178] https://'
[[ "$redirect" =~ $redirect_pattern ]] || fail "HTTP is not redirected to HTTPS: $redirect"
pass "HTTP redirects to HTTPS ($redirect)"

step "sign in"
jar="$work/cookies"
"${curl_tls[@]}" -c "$jar" -b "$jar" -o /dev/null "${base}/login"
xsrf="$(awk '$6 == "XSRF-TOKEN" { print $7 }' "$jar" | python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.stdin.read().strip()))')"
[ -n "$xsrf" ] || fail "no XSRF-TOKEN cookie from /login"
login="$("${curl_tls[@]}" -c "$jar" -b "$jar" -o /dev/null -w '%{http_code} %{redirect_url}' \
    -H "X-XSRF-TOKEN: ${xsrf}" -H 'Accept: text/html' \
    --data-urlencode "email=${admin_email}" --data-urlencode "password=${password}" "${base}/login")"
login_pattern="^302 ${base}/(dashboard|admin)"
[[ "$login" =~ $login_pattern ]] || fail "POST /login: $login"
after="$("${curl_tls[@]}" -c "$jar" -b "$jar" -o /dev/null -L -w '%{http_code} %{url_effective}' "${base}/admin")"
ok_pattern='^200 '
login_page='/login$'
{ [[ "$after" =~ $ok_pattern ]] && ! [[ "$after" =~ $login_page ]]; } || fail "signed-in request to /admin: $after"
pass "POST /login = ${login}; /admin then answers ${after} (the one-time password asks for confirmation and 2FA next)"

step "no one-time token in Caddy's access log"
"${curl_tls[@]}" -o /dev/null "${base}/reset-password/SMOKESECRETTOKEN?email=smoke%40example.com"
"${curl_tls[@]}" -o /dev/null -H "Referer: ${base}/staff-invitation/SMOKESECRETREFERER" "${base}/login?signature=SMOKESECRETSIG"
access_log=""
for _ in $(seq 30); do
    access_log="$("${compose[@]}" logs --no-color caddy)"
    grep -q '"uri":"/login?REDACTED"' <<< "$access_log" && break
    sleep 1
done
grep -q 'SMOKESECRET' <<< "$access_log" && fail "a URL token reached Caddy's logs"
grep -q '"uri":"/reset-password/REDACTED?REDACTED"' <<< "$access_log" || fail "the access log does not show the redacted reset link"
pass "URL tokens are redacted in Caddy's access log (path, query and Referer)"

# Queue RunAutomationJob through the live web container and wait for the live colour's automation worker (its own
# `automation` connection; the job fails itself on any other) to finish it.
queued_job() {
    local colour="$1" logs finished before last=""
    finished='RunAutomationJob .*(DONE|FAIL)'
    # Count and read from one snapshot of the logs per check: two separate reads can straddle the moment the job
    # finishes, and then the count says "done" while the line read just before is still empty (smoke run 39438486679).
    worker_logs() { "${compose[@]}" logs --no-color "worker-automation-$colour" 2>/dev/null || true; }
    before="$(worker_logs | grep -cE "$finished" || true)"
    "${compose[@]}" exec -T "app-$colour" php artisan tinker --execute \
        'App\Modules\Platform\Jobs\RunAutomationJob::dispatch(); echo "queued\n";' >/dev/null
    for _ in $(seq 60); do
        logs="$(worker_logs)"
        if [ "$(grep -cE "$finished" <<< "$logs" || true)" -gt "$before" ]; then
            last="$(grep -E "$finished" <<< "$logs" | tail -1)"
            break
        fi
        sleep 2
    done
    [[ "$last" =~ DONE ]] || fail "RunAutomationJob was not processed by worker-automation-$colour: ${last:-no worker output in 120 s}"
    failed_jobs="$("${compose[@]}" exec -T "app-$colour" php artisan tinker --execute 'echo DB::table("failed_jobs")->count();' | tail -1)"
    [ "$failed_jobs" = 0 ] || fail "failed_jobs = $failed_jobs"
    pass "RunAutomationJob processed by worker-automation-$colour on its own connection; failed_jobs = 0"
}

step "queued job through the live colour's automation worker"
queued_job blue

step "container hardening, outbound TLS and per-container caches"
uid="$("${compose[@]}" exec -T app-blue id -u)"
[ "$uid" = 10001 ] || fail "app runs as UID $uid"
if "${compose[@]}" exec -T app-blue sh -c 'touch /app/smoke-write-test' 2>/dev/null; then
    fail "the app's root filesystem is writable"
fi
pass "app runs as UID 10001 on a read-only root filesystem"
"${compose[@]}" exec -T app-blue php -r 'exit(@file_get_contents("https://example.com") === false ? 1 : 0);' \
    || fail "PHP stream TLS (SMTP STARTTLS, https:// streams) cannot verify a public certificate"
pass "PHP stream TLS verifies a public certificate (CA bundle)"
views="$("${compose[@]}" exec -T app-blue sh -c 'ls /app/bootstrap/cache/views | wc -l; ls -A /app/storage/framework/views | grep -vc gitignore || true')"
[ "$(sed -n 1p <<< "$views")" -gt 0 ] && [ "$(sed -n 2p <<< "$views")" = 0 ] \
    || fail "compiled views must be per container, not in the shared storage volume (got: $(tr '\n' ' ' <<< "$views"))"
pass "compiled views are per container ($(sed -n 1p <<< "$views") in bootstrap/cache/views, none in storage)"

# A steady request loop against /up through Caddy while a deploy or rollback runs; every response must be 200.
start_loop() {
    : > "$work/loop.log"
    ( while :; do "${curl_tls[@]}" -o /dev/null -w '%{http_code}\n' "${base}/up" >> "$work/loop.log" 2>/dev/null || echo 000 >> "$work/loop.log"; sleep 0.2; done ) &
    loop_pid=$!
}
stop_loop() {
    kill "$loop_pid" 2>/dev/null || true
    wait "$loop_pid" 2>/dev/null || true
    loop_pid=""
    total="$(wc -l < "$work/loop.log")"
    bad="$(grep -vc '^200$' "$work/loop.log" || true)"
    [ "$bad" = 0 ] || fail "$bad of $total requests failed during the $1 ($(sort "$work/loop.log" | uniq -c | tr '\n' ' '))"
    pass "$total requests during the $1, none failed"
}
assert_live() {
    local live="$1" old="$2"
    "${compose[@]}" exec -T caddy wget -qO- http://127.0.0.1:2019/config/ | grep -q "app-${live}:8080" \
        || fail "Caddy's running configuration does not name app-$live"
    "${curl_tls[@]}" -o /dev/null "${base}/up"
    sleep 1
    "${compose[@]}" logs --no-color --since 30s caddy | grep '"upstream":' | tail -1 | grep -q "\"upstream\":\"app-${live}" \
        || fail "the last request through Caddy was not served by app-$live"
    local now
    now="$(running)"
    for service in "app-$live" "scheduler-$live" "worker-automation-$live" "worker-critical-$live" "worker-default-$live" "worker-notifications-$live" "app-$old"; do
        grep -qw "$service" <<< "$now" || fail "$service is not running after the switch (running: $now)"
    done
    for service in "scheduler-$old" "worker-automation-$old" "worker-critical-$old" "worker-default-$old" "worker-notifications-$old"; do
        grep -qw "$service" <<< "$now" && fail "$service still runs after the switch (one scheduler, old workers drained)"
    done
    pass "live: $live (Caddy config and access log); one scheduler and one automation worker; $old workers drained; app-$old kept for rollback"
}

step "blue-green deploy to green under load (with a Caddyfile changed the way git pull changes it)"
# git replaces a changed file with a new one (a new inode); Caddy must read the new file on the deploy's reload.
cp deploy/caddy/Caddyfile "$work/Caddyfile.orig"
{ cat "$work/Caddyfile.orig"; printf '\n# smoke: changed before the deploy to green\n'; } > deploy/caddy/Caddyfile.new
mv deploy/caddy/Caddyfile.new deploy/caddy/Caddyfile
start_loop
start=$(date +%s)
deploy/bin/deploy --image "$image" || fail "blue-green deploy"
stop_loop "deploy to green ($(( $(date +%s) - start ))s)"
"${compose[@]}" exec -T caddy grep -q 'smoke: changed before the deploy to green' /etc/caddy/conf/Caddyfile \
    || fail "Caddy still reads the Caddyfile from before the change"
mv "$work/Caddyfile.orig" deploy/caddy/Caddyfile
pass "Caddy reads the Caddyfile as changed in the checkout (directory mount)"
assert_live green blue
queued_job green

step "rollback to blue under load"
start_loop
deploy/bin/deploy rollback || fail "rollback"
stop_loop "rollback"
assert_live blue green
queued_job blue

step "full demo seed on PostgreSQL (real commits, non-production APP_ENV)"
# The stack is APP_ENV=production, where DatabaseSeeder skips demo data, and its image has no dev dependencies, which
# the demo seeders need (Faker, factories). So: build the `smoke-seed` target of the same Dockerfile (dev dependencies,
# smoke only, never deployed) and run it once, with APP_ENV=local, on the stack's backend network against its
# PostgreSQL. deploy/.env.smoke and the running services stay production. Refuse unless this is a smoke project and
# the environment is not production: the demo accounts have a known password.
seed_env=local
case "$project" in mohar-smoke|mohar-smoke-*) ;; *) fail "refusing to seed project '$project': not a smoke project" ;; esac
[ "$seed_env" != production ] || fail "refusing to seed demo data with APP_ENV=production"
seed_image="${image%:*}:smoke-seed"
start=$(date +%s)
docker build -q -f deploy/Dockerfile --target smoke-seed -t "$seed_image" . > /dev/null || fail "build of the smoke-seed image"
pass "smoke-seed image built in $(( $(date +%s) - start ))s"
docker run --rm --init --network "${project}_backend" --env-file "$env_file" \
    -e APP_ENV="$seed_env" -e DB_CONNECTION=pgsql -e DB_HOST=postgres -e DB_PORT=5432 \
    -e OBJECTS_DRIVER=s3 -e OBJECTS_ENDPOINT=http://rustfs:9000 \
    "$seed_image" sh -c 'test "$APP_ENV" != production && php artisan db:seed --force --no-interaction' > "$work/seed.log" 2>&1 \
    || { tail -40 "$work/seed.log" >&2; fail "db:seed --force (APP_ENV=$seed_env)"; }
grep -qi 'demo data skipped' "$work/seed.log" && fail "the seeder skipped demo data: APP_ENV was not applied"
seeded="$("${compose[@]}" exec -T postgres psql -U billing -d billing -Atc 'select count(*) from users')" \
    || fail "psql could not count users in the stack's PostgreSQL after db:seed"
[ "${seeded:-0}" -gt 1 ] || fail "no demo accounts after db:seed (users = ${seeded:-none})"
pass "db:seed --force ran the demo seeders on PostgreSQL after migrations (APP_ENV=$seed_env, users = $seeded)"

failed=0
step "all checks passed"
