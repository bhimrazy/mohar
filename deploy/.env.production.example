# Production settings for deploy/compose.prod.yaml (billing/docs/devops/production.md).
#   cp deploy/.env.production.example deploy/.env && chmod 600 deploy/.env
# Compose reads this file for the ${...} values in compose.prod.yaml, and the PHP containers read it as their
# environment. Keep it out of git and out of backups that sit next to the database dumps (APP_KEY decrypts the
# stored gateway, registrar and server credentials).
#
# Values with spaces need quotes. DB_HOST, DB_PORT, OBJECTS_DRIVER, OBJECTS_ENDPOINT and TRUSTED_PROXIES are set by
# compose.prod.yaml for the containers; do not set them here.

# ---------------------------------------------------------------- Site
# The public name Caddy serves and requests a certificate for (DNS A/AAAA records must point at this host).
APP_DOMAIN=billing.example.com
APP_URL=https://billing.example.com
# Shown until staff set the brand (Admin -> Settings -> Appearance).
APP_NAME="Example Hosting"
# Generate once: docker compose -f deploy/compose.prod.yaml run --rm --no-deps -e APP_OPTIMIZE=0 migrate php artisan key:generate --show
# Or leave it empty and read it from a Docker secret (deploy/compose.secrets.example.yaml).
APP_KEY=
# When rotating APP_KEY, keep the old key(s) here, comma-separated, until `php artisan security:reencrypt` has run
# (billing/docs/devops/key-rotation.md).
APP_PREVIOUS_KEYS=
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_LEVEL=info

# ---------------------------------------------------------------- Caddy (edge proxy)
# Caddy global options. Set your own email (Let's Encrypt refuses example.com addresses): certificate expiry notices,
# and ZeroSSL as a fallback issuer (without an email Caddy uses Let's Encrypt only).
# CADDY_GLOBAL_OPTIONS="email ops@your-company.tld"
# Leave empty for real certificates. `tls internal` uses Caddy's own CA (test hosts only).
CADDY_TLS=
HTTP_PORT=80
HTTPS_PORT=443
# The edge network's range; the app trusts X-Forwarded-* only from it. Change it if it overlaps a host network.
EDGE_SUBNET=172.30.10.0/24

# ---------------------------------------------------------------- Image
# deploy/bin/deploy builds the checkout (mohar-app:<commit>) or takes --image ghcr.io/<owner>/<repo>@sha256:<digest>,
# and records each colour's image in deploy/state/deploy.env. Nothing to set here.

# ---------------------------------------------------------------- PostgreSQL (the postgres service)
DB_DATABASE=billing
DB_USERNAME=billing
# Long and random: openssl rand -base64 32
DB_PASSWORD=

# ---------------------------------------------------------------- Object storage (the rustfs service)
OBJECTS_BUCKET=billing
OBJECTS_REGION=us-east-1
OBJECTS_PATH_STYLE=true
# The RustFS root credentials (used by the app too). Long and random.
OBJECTS_ACCESS_KEY=
OBJECTS_SECRET_KEY=

# ---------------------------------------------------------------- Queue, cache, sessions
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------- Mail (required: password resets, invoices)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@example.com
MAIL_FROM_NAME="Example Hosting"
